# Archive RPC URL for Arbitrum One state and block queries
# Real credentials live in ~/.nexus/rpc.env (D-032); loaded via environment
ARBITRUM_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/<api-key>"

# Optional: override path to the file-flag kill switch (defaults to ~/.nexus/KILL)
# NEXUS_KILL_PATH="/path/to/KILL"

# Optional: custom path to anvil binary (defaults to "anvil" on PATH)
# ANVIL_BIN="/path/to/anvil"
